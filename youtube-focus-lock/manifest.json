{
  "manifest_version": 3,
  "name": "YouTube Focus Lock",
  "version": "0.2.1",
  "description": "Blocks YouTube except during a fixed daily access window.",
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "storage",
    "tabs",
    "management"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "*://*.youtube-nocookie.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "src/content-guard.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "YouTube Focus Lock",
    "default_popup": "status.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "src/blocked.js",
        "lib/schedule.mjs",
        "lib/config.mjs"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
