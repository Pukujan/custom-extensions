{
  "manifest_version": 3,
  "name": "Dark Mode Control",
  "version": "1.0.0",
  "description": "Dark mode for websites in Brave, with contrast, brightness and warmth saved per site.",
  "permissions": ["storage", "activeTab"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Dark Mode Control" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["core.js", "vendor/darkreader.js", "content.js"],
    "run_at": "document_start",
    "all_frames": true
  }]
}
