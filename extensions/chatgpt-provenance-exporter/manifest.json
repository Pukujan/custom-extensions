{
  "manifest_version": 3,
  "name": "ChatGPT Provenance Exporter",
  "version": "0.1.0",
  "description": "Capture one ChatGPT conversation as raw provenance evidence plus derived graph, tool, rendered, reconciliation, and integrity indexes.",
  "permissions": [
    "activeTab",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "core.js",
        "content.js",
        "account-core.js",
        "account-runner.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT Provenance Exporter"
  }
}
